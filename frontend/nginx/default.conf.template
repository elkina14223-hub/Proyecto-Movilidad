server_tokens off;   # RNF-SEG-05: ocultar la versión del servidor

# Mensajería sincrónica: permite que /api/ws suba de HTTP a WebSocket (wss:// bajo HTTPS)
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

# HTTP -> HTTPS con redirección 301 (RNF-SEG-02)
server {
    listen 80;
    server_name _;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host${PUBLIC_HTTPS_SUFFIX}$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    # Rutas por variable: certificado de Let's Encrypt en producción o autofirmado en desarrollo
    ssl_certificate     ${SSL_CERT_PATH};
    ssl_certificate_key ${SSL_KEY_PATH};
    # TLS 1.3 con TLS 1.2 de respaldo y suites AES-GCM (RNF-SEG-04)
    ssl_protocols TLSv1.3 TLSv1.2;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    include /etc/nginx/snippets/security-headers.conf;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;   # el WebSocket permanece abierto
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Para mostrar en la web con qué protocolo y cifrado se conectó la persona
        proxy_set_header X-TLS-Protocol $ssl_protocol;
        proxy_set_header X-TLS-Cipher $ssl_cipher;
        proxy_hide_header Server;
        # add_header en un location anula los heredados: se repiten
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Recursos estáticos con hash: caché larga (RNF-ESC-01: servir desde la caché)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # El service worker y el manifiesto no se cachean por mucho tiempo
    location = /sw.js { add_header Cache-Control "no-cache"; include /etc/nginx/snippets/security-headers.conf; }
    location = /index.html { add_header Cache-Control "no-cache"; include /etc/nginx/snippets/security-headers.conf; }

    # SPA: cualquier otra ruta devuelve index.html
    location / { try_files $uri /index.html; }
}
