# Imagen única para Render: compila el front-end (React) y lo sirve junto con la API (FastAPI).
# Render pone el HTTPS (certificado administrado) y entrega el puerto en la variable PORT.

# ---- 1) Compilar la web ----
FROM node:22-alpine AS web
WORKDIR /web
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ .
# Opcional: clave de MapTiler. Sin clave el mapa usa OpenStreetMap público.
ARG VITE_MAPTILER_KEY=""
ENV VITE_MAPTILER_KEY=$VITE_MAPTILER_KEY
RUN npm run build

# ---- 2) API + web estática ----
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app ./app
COPY backend/db ./db
COPY --from=web /web/dist ./static
RUN useradd --create-home appuser
USER appuser
ENV STATIC_DIR=/srv/static
EXPOSE 10000
# --proxy-headers: toma la IP y el protocolo reales que informa el proxy de Render
# --no-server-header: no revela la versión del servidor (RNF-SEG-05)
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-10000} --no-server-header --ws-max-size 4096 --proxy-headers --forwarded-allow-ips '*'"]
